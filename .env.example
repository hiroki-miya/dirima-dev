POSTGRES_PASSWORD=change-me
DIRIMA_TOKEN=replace-with-long-random-token
DIRIMA_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
# Optional structured model endpoint; never commit the API key.
DIRIMA_MODEL_BASE_URL=
DIRIMA_MODEL_API_KEY=
DIRIMA_MODEL_PROVIDER=compatible
DIRIMA_MODEL_EXTRACTOR=
DIRIMA_MODEL_CLUSTER=
DIRIMA_MODEL_CONFLICT_DETECTOR=
DIRIMA_MODEL_RESOLVER=
DIRIMA_MODEL_RISK_CLASSIFIER=
DIRIMA_MODEL_RECEIPT_GENERATOR=
# Source characters per extractor chunk; all content is retained.
DIRIMA_EXTRACTION_CHARS=24000
